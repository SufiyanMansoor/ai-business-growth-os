rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('owner');
    }

    function isAgencyOrAdmin() {
      return isAdmin() || hasRole('agency');
    }

    function hasTenantMembership(tenantId) {
      return isAuthenticated() && tenantId != null &&
        exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid));
    }

    function tenantRole(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role;
    }

    function isTenantElevated(tenantId) {
      return hasTenantMembership(tenantId) &&
        (tenantRole(tenantId) == 'owner' ||
         tenantRole(tenantId) == 'admin' ||
         tenantRole(tenantId) == 'manager' ||
         tenantRole(tenantId) == 'agency');
    }

    // Tenants & memberships
    match /tenants/{tenantId} {
      allow read: if hasTenantMembership(tenantId);
      // Tenant doc creation happens just before the membership doc is created (see RegisterPage),
      // so we only require authentication here; subsequent updates/deletes require elevated tenant role.
      allow create: if isAuthenticated() && request.resource.data.id == tenantId;
      allow update, delete: if isTenantElevated(tenantId);

      match /members/{memberUid} {
        allow read: if hasTenantMembership(tenantId) && (memberUid == request.auth.uid || isTenantElevated(tenantId));
        allow create, update, delete: if isTenantElevated(tenantId) || memberUid == request.auth.uid;
      }
    }

    // Users
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Campaigns
    match /campaigns/{campaignId} {
      allow read: if isAuthenticated() &&
        (
          (resource.data.tenantId != null && hasTenantMembership(resource.data.tenantId) &&
            (resource.data.userId == request.auth.uid ||
             resource.data.clientId == request.auth.uid ||
             isTenantElevated(resource.data.tenantId)))
          ||
          (resource.data.tenantId == null &&
            (resource.data.userId == request.auth.uid ||
             resource.data.clientId == request.auth.uid ||
             isAgencyOrAdmin()))
        );
      allow create: if isAuthenticated() &&
        (request.resource.data.tenantId == null || hasTenantMembership(request.resource.data.tenantId));
      allow update: if isAuthenticated() &&
        (
          (resource.data.tenantId != null && hasTenantMembership(resource.data.tenantId) &&
            (resource.data.userId == request.auth.uid || isTenantElevated(resource.data.tenantId)))
          ||
          (resource.data.tenantId == null &&
            (resource.data.userId == request.auth.uid || isAgencyOrAdmin()))
        );
      allow delete: if isAuthenticated() &&
        (
          (resource.data.tenantId != null && hasTenantMembership(resource.data.tenantId) && isTenantElevated(resource.data.tenantId))
          ||
          (resource.data.tenantId == null && isAgencyOrAdmin())
        );
    }

    // Leads / CRM
    match /leads/{leadId} {
      allow read, write: if isAuthenticated() &&
        (
          (resource.data.tenantId != null && hasTenantMembership(resource.data.tenantId) &&
            (resource.data.userId == request.auth.uid || isTenantElevated(resource.data.tenantId)))
          ||
          (resource.data.tenantId == null &&
            (resource.data.userId == request.auth.uid || isAgencyOrAdmin()))
        );
      allow create: if isAuthenticated() &&
        (request.resource.data.tenantId == null || hasTenantMembership(request.resource.data.tenantId));
    }

    // Content (social posts, generated content)
    match /content/{contentId} {
      allow read: if isAuthenticated() &&
        (resource.data.tenantId == null || hasTenantMembership(resource.data.tenantId));

      allow create: if isAuthenticated() &&
        (request.resource.data.tenantId == null || hasTenantMembership(request.resource.data.tenantId));

      allow update: if isAuthenticated() &&
        (
          (resource.data.tenantId != null && hasTenantMembership(resource.data.tenantId) &&
            (resource.data.userId == request.auth.uid || isTenantElevated(resource.data.tenantId)))
          ||
          (resource.data.tenantId == null &&
            (resource.data.userId == request.auth.uid || isAgencyOrAdmin()))
        );
      allow delete: if isAuthenticated() &&
        (
          (resource.data.tenantId != null && hasTenantMembership(resource.data.tenantId) && isTenantElevated(resource.data.tenantId))
          ||
          (resource.data.tenantId == null && isAgencyOrAdmin())
        );
    }

    // Influencers
    match /influencers/{influencerId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
        (
          (resource.data.tenantId != null && hasTenantMembership(resource.data.tenantId) && isTenantElevated(resource.data.tenantId))
          ||
          (resource.data.tenantId == null && isAgencyOrAdmin())
        );
    }

    // Outreach campaigns
    match /outreach/{outreachId} {
      allow read, write: if isAuthenticated() &&
        (
          (resource.data.tenantId != null && hasTenantMembership(resource.data.tenantId) &&
            (resource.data.userId == request.auth.uid || isTenantElevated(resource.data.tenantId)))
          ||
          (resource.data.tenantId == null && resource.data.userId == request.auth.uid)
        );
      allow create: if isAuthenticated() &&
        (request.resource.data.tenantId == null || hasTenantMembership(request.resource.data.tenantId));
    }

    // Reports
    match /reports/{reportId} {
      allow read: if isAuthenticated() &&
        (
          (resource.data.tenantId != null && hasTenantMembership(resource.data.tenantId) &&
            (resource.data.userId == request.auth.uid ||
             resource.data.clientId == request.auth.uid ||
             isTenantElevated(resource.data.tenantId)))
          ||
          (resource.data.tenantId == null &&
            (resource.data.userId == request.auth.uid ||
             resource.data.clientId == request.auth.uid ||
             isAgencyOrAdmin()))
        );
      allow create: if isAuthenticated() &&
        (request.resource.data.tenantId == null || hasTenantMembership(request.resource.data.tenantId));
    }

    // Analytics events
    match /analytics/{eventId} {
      allow read: if isAuthenticated() &&
        (resource.data.tenantId == null || hasTenantMembership(resource.data.tenantId));
      allow create: if isAuthenticated() &&
        (request.resource.data.tenantId == null || hasTenantMembership(request.resource.data.tenantId));
    }

    // Autopilot jobs
    match /autopilot/{jobId} {
      allow read, write: if isAuthenticated() &&
        (
          (resource.data.tenantId != null && hasTenantMembership(resource.data.tenantId) &&
            (resource.data.userId == request.auth.uid || isTenantElevated(resource.data.tenantId)))
          ||
          (resource.data.tenantId == null && resource.data.userId == request.auth.uid)
        );
      allow create: if isAuthenticated() &&
        (request.resource.data.tenantId == null || hasTenantMembership(request.resource.data.tenantId));
    }

    // Client portal access
    match /clientAccess/{accessId} {
      allow read: if isAuthenticated();
      allow write: if isAgencyOrAdmin() ||
        (resource.data.tenantId != null && hasTenantMembership(resource.data.tenantId) && isTenantElevated(resource.data.tenantId));
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() &&
        (
          (resource.data.tenantId != null && hasTenantMembership(resource.data.tenantId) &&
            (resource.data.userId == request.auth.uid || isTenantElevated(resource.data.tenantId)))
          ||
          (resource.data.tenantId == null && resource.data.userId == request.auth.uid)
        );
      allow create: if isAuthenticated() &&
        (request.resource.data.tenantId == null || hasTenantMembership(request.resource.data.tenantId));
    }
  }
}
